{
  "id" : "com.groupc.Compressor",
  "runtime" : "org.gnome.Platform",
  "runtime-version" : "49",
  "runtime-commit" : "d9a9425766accf8efe5660b6563bab7119c7155d25a90c16455d0cd33d603c35",
