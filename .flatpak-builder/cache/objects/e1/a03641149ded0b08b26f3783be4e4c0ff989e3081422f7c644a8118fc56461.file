  "sdk-commit" : "39cc2c47a919b6df8452d01eda94e308162b0a344e1207f55d5ee90945c38bd8",
  "command" : "compressor",
  "modules" : [
    {
      "name" : "compressor",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : "..",
          "type" : "dir"
        }
      ],
      "build-commands" : [
        "rm -f compressor",
        "make",
        "install -Dm755 compressor /app/bin/compressor",
        "install -Dm644 compressor.ui /app/share/compressor/compressor.ui",
        "install -Dm644 Style.css /app/share/compressor/Style.css"
      ]
    }
  ],
  "finish-args" : [
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--filesystem=home"
  ],
  "source-date-epoch" : 1790216139
}